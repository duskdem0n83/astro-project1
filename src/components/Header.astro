---
import DarkModeToggle from './DarkModeToggle.astro';
import SearchBar from './SearchBar.astro';
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border-b border-slate-200 dark:border-slate-700">
  <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-2xl font-bold text-slate-900 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      My Blog
    </a>
    <div class="flex items-center gap-4">
      <SearchBar />
      <DarkModeToggle />
    </div>
  </nav>
</header>
