---
interface Props {
  content?: string;
}

const { content = '' } = Astro.props;

// Extract headings from markdown content (supports #, ##, ###)
const headingRegex = /^(#{1,3})\s+(.+)$/gm;
const headings: Array<{ level: number; text: string; id: string }> = [];

if (content) {
  let match;
  while ((match = headingRegex.exec(content)) !== null) {
    const level = match[1].length;
    const text = match[2].trim();
    const id = text
      .toLowerCase()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .trim();
    
    headings.push({ level, text, id });
  }
}

if (headings.length === 0) {
  return null;
}
---

<nav class="toc mb-8 p-6 bg-slate-100 dark:bg-slate-800 rounded-lg border border-slate-200 dark:border-slate-700">
  <h2 class="text-lg font-semibold mb-4 text-slate-900 dark:text-slate-100">
    Table of Contents
  </h2>
  <ul class="space-y-2">
    {headings.map((heading) => (
      <li
        class={`text-sm ${
          heading.level === 1
            ? 'font-semibold'
            : heading.level === 2
            ? 'ml-4'
            : 'ml-8'
        }`}
      >
        <a
          href={`#${heading.id}`}
          class="text-slate-700 dark:text-slate-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc a {
    @apply no-underline;
  }
  
  .toc a:hover {
    @apply underline;
  }
</style>
