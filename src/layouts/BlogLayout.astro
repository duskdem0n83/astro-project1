---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import TableOfContents from '../components/TableOfContents.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { calculateReadingTime } from '../utils/readingTime';
import { getRelatedPosts } from '../utils/relatedPosts';
import { getPosts } from '../utils/getPosts';

interface Props {
  post: CollectionEntry<'blog'>;
  rawContent?: string;
}

const { post, rawContent = '' } = Astro.props;
const { title, description, publishDate, tags, author, image } = post.data;
const readingTime = calculateReadingTime(rawContent);
const allPosts = await getPosts();
const relatedPosts = getRelatedPosts(post, allPosts, 3);
const canonicalURL = new URL(`/blog/${post.slug}`, Astro.site);
const postImage = image ? new URL(image, Astro.site) : null;

// JSON-LD structured data
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: postImage?.toString(),
  datePublished: publishDate.toISOString(),
  dateModified: publishDate.toISOString(),
  author: {
    '@type': 'Person',
    name: author,
  },
  publisher: {
    '@type': 'Organization',
    name: 'My Bucking Blog',
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL.toString(),
  },
  keywords: tags.join(', '),
};
---

<BaseLayout title={title} description={description} image={image}>
  <ReadingProgress />
  <article class="container mx-auto px-4 py-8 max-w-4xl" itemscope itemtype="https://schema.org/BlogPosting">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    
    <header class="mb-8">
      <h1 class="text-4xl font-bold text-slate-900 dark:text-slate-100 mb-4" itemprop="headline">{title}</h1>
      <div class="flex flex-wrap items-center gap-4 text-sm text-slate-600 dark:text-slate-400 mb-4">
        <time datetime={publishDate.toISOString()} itemprop="datePublished">
          {publishDate.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span>•</span>
        <span itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span itemprop="name">By {author}</span>
        </span>
        <span>•</span>
        <span>{readingTime} min read</span>
      </div>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/blog/tag/${tag}`}
              class="px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-800 dark:text-blue-200 text-sm hover:bg-blue-200 dark:hover:bg-blue-800 transition-colors"
            >
              {tag}
            </a>
          ))}
        </div>
      )}
    </header>

    {rawContent && <TableOfContents content={rawContent} />}

    <div class="prose-custom prose-lg" itemprop="articleBody">
      <slot />
    </div>

    <RelatedPosts posts={relatedPosts} />
  </article>
</BaseLayout>
